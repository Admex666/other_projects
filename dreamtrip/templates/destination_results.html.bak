<!DOCTYPE html>
<html lang="hu">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eredmények - Optivoya</title>
    <link rel="icon" type="image/png" href="/static/logo.png">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .navbar {
            background: rgba(255, 255, 255, 0.95);
            padding: 20px 40px;
            border-radius: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .logo-text {
            font-size: 24px;
            font-weight: 700;
            color: #235B2A;
            margin-left: 10px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .logout-btn {
            background: #235B2A;
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
        }

        .logout-btn:hover {
            background: #90DC25;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
            padding: 20px;
        }

        header {
            background: linear-gradient(135deg, #235B2A 0%, #1a4520 100%);
            color: white;
            padding: 30px 20px;
            border-radius: 20px;
            margin-bottom: 40px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(35, 91, 42, 0.2);
        }

        h1 {
            margin-bottom: 10px;
            font-size: 32px;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .results-list {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .result-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            display: flex;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s;
            position: relative;
        }

        .result-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .rank-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            background: #FFD700;
            color: #333;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 20px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
            z-index: 10;
        }

        .card-img {
            width: 300px;
            object-fit: cover;
            flex-shrink: 0;
        }

        .card-content {
            padding: 25px;
            flex-grow: 1;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .destination-title {
            font-size: 24px;
            font-weight: 700;
            color: #333;
        }

        .destination-country {
            color: #777;
            font-size: 14px;
            font-weight: 400;
        }

        .match-score {
            text-align: right;
        }

        .score-val {
            font-size: 28px;
            font-weight: 700;
            color: #235B2A;
            display: block;
        }

        .score-label {
            font-size: 12px;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .explanation-box {
            background: #f1f8f3;
            border-left: 4px solid #235B2A;
            padding: 12px 15px;
            margin-bottom: 15px;
            border-radius: 0 8px 8px 0;
        }

        .explanation-text {
            color: #2d5a32;
            font-size: 14px;
            line-height: 1.5;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #eee;
        }

        .metric-item {
            text-align: center;
        }

        .metric-val {
            display: block;
            font-weight: 600;
            color: #333;
        }

        .metric-label {
            font-size: 12px;
            color: #999;
        }

        .actions {
            margin-top: 20px;
            text-align: right;
        }

        .btn-view {
            text-decoration: none;
            color: white;
            background: #235B2A;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 14px;
            display: inline-block;
        }

        .btn-back {
            display: inline-block;
            text-decoration: none;
            color: rgba(255, 255, 255, 0.8);
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 20px;
            transition: all 0.3s;
        }

        .btn-back:hover {
            color: white;
            transform: translateX(-5px);
        }

        @media (max-width: 768px) {
            .result-card {
                flex-direction: column;
            }

            .card-img {
                width: 100%;
                height: 200px;
            }

            .metrics-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* Loader */
        #loader {
            display: none;
            background: white;
            border-radius: 20px;
            padding: 50px;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            margin-top: 20px;
        }

        .spinner {
            width: 50px;
            height: 50px;
            border: 5px solid #f3f3f3;
            border-top: 5px solid #235B2A;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .progress-bar-container {
            width: 100%;
            height: 10px;
            background: #eee;
            border-radius: 5px;
            margin-top: 20px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #235B2A, #90DC25);
            width: 0%;
            transition: width 0.3s;
        }
    </style>
</head>

<body>
    <div class="navbar">
        <a href="/home" style="text-decoration: none; display: flex; align-items: center; gap: 10px;">
            <img src="/static/logo.png" alt="Optivoya" style="height: 40px;">
            <span class="logo-text">Optivoya</span>
        </a>
        <div class="user-info">
            <span style="color: #666;">👤 {{ user }}</span>
            <a href="/logout" class="logout-btn">Kilépés</a>
        </div>
    </div>
    <header>
        <div class="container">
            <a href="/destination-preferences" class="btn-back">← Vissza a finomhangoláshoz</a>
            <h1>🏆 Top Úticélok Neked</h1>
            <p>A beállított szempontok alapján ezek a legalkalmasabb helyek.</p>
        </div>
    </header>

    <div class="container">
        <div id="loader">
            <div class="spinner"></div>
            <h3>🔍 Élő adatok gyűjtése...</h3>
            <p id="statusText">Várj egy pillanatot, amíg lekérjük a legfrissebb időjárást és repülőjegy árakat.</p>
            <div class="progress-bar-container">
                <div class="progress-bar" id="progressBar"></div>
            </div>
        </div>

        <div class="results-list" id="resultsList" style="display: none;">
            <!-- Populated by JS -->
        </div>

        <div style="text-align: center; margin-top: 40px;">
            <a href="/destination-matcher" style="color: #666; text-decoration: none;">🔄 Új keresés indítása</a>
        </div>
    </div>

    <script>
        // REAL DATA from Jinja2
        var results;
        // {% if results %}
        results = {{ results | tojson }};
        // {% else %}
        results = [];
        // {% endif %}

        const list = document.getElementById('resultsList');
        const loader = document.getElementById('loader');
        const statusText = document.getElementById('statusText');
        const progressBar = document.getElementById('progressBar');

        async function checkStatus() {
            try {
                const response = await fetch('/api/destination-calculation-status');
                const data = await response.json();

                if (data.status === 'running') {
                    loader.style.display = 'block';
                    list.style.display = 'none';
                    if (data.status_text) statusText.innerText = data.status_text;
                    if (data.progress !== undefined) progressBar.style.width = data.progress + '%';
                    setTimeout(checkStatus, 2000);
                } else if (data.status === 'done') {
                    location.reload();
                } else if (data.status === 'error') {
                    loader.innerHTML = `<h3 style="color:red">Hiba történt</h3><p>${data.error}</p>`;
                } else if (data.status === 'idle') {
                    if ({{ results | length }
                } > 0) {
                    loader.style.display = 'none';
                    list.style.display = 'flex';
                    renderResults();
                } else {
                    statusText.innerText = "Nincs adat. Indíts új keresést.";
                }
            }
            } catch (e) {
            console.error(e);
        }
        }

        function renderResults() {
            list.innerHTML = '';
            results.forEach((res, index) => {
                const card = document.createElement('div');
                card.className = 'result-card';
                card.innerHTML = `
                    <div class="rank-badge">${res.rank}</div>
                    <img src="${res.image}" class="card-img" alt="${res.name}">
                    <div class="card-content">
                        <div class="card-header">
                            <div>
                                <div class="destination-title">${res.name}</div>
                                <div class="destination-country">${res.country}</div>
                            </div>
                            <div class="match-score">
                                <span class="score-val">${res.score}%</span>
                                <span class="score-label">Egyezés</span>
                            </div>
                        </div>
                        
                        <div class="explanation-box">
                            <div class="explanation-text">💡 <b>Miért ez?</b> ${res.explanation}</div>
                        </div>

                        <div class="metrics-grid">
                            <div class="metric-item">
                                <span class="metric-val">${res.metrics.temp}</span>
                                <span class="metric-label">Időjárás</span>
                            </div>
                            <div class="metric-item">
                                <span class="metric-val">${res.metrics.cost}</span>
                                <span class="metric-label">Költség / nap</span>
                            </div>
                             <div class="metric-item">
                                <span class="metric-val">${res.metrics.flight}</span>
                                <span class="metric-label">Repülőjegy</span>
                            </div>
                             <div class="metric-item">
                                <span class="metric-val">${res.metrics.travel}</span>
                                <span class="metric-label">Utazási idő</span>
                            </div>
                        </div>
                        
                        <div class="actions">
                            <a href="/accommodation-intelligence?city=${res.name}" class="btn-view">Szállások keresése ➔</a>
                        </div>
                    </div>
                `;
                list.appendChild(card);
            });
        }

        if (results.length === 0) {
            checkStatus();
        } else {
            loader.style.display = 'none';
            list.style.display = 'flex';
            renderResults();
        }
    </script>
</body>

</html>