generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String    @id @default(uuid())
  name         String
  industry     String?
  orgStructure Json?
  
  users        User[]
  sessions     Session[]
}

model User {
  id             String       @id @default(uuid())
  name           String
  role           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  teamMembership String? // Deprecated, use SessionParticipant.teamId instead
  
  sessions             SessionParticipant[]
  sentInteractions     Interaction[]        @relation("SentInteractions")
  receivedInteractions Interaction[]        @relation("ReceivedInteractions")
  surveyResponses      SurveyResponse[]     @relation("SurveyResponder")
  surveyTargets        SurveyResponse[]     @relation("SurveyTarget")
  sentTrades           TradeRequest[]       @relation("SentTrades")
  receivedTrades       TradeRequest[]       @relation("ReceivedTrades")
}

model Scenario {
  id              String    @id @default(uuid())
  name            String
  behavioralFocus String?
  config          Json
  version         String
  
  sessions        Session[]
}

model Session {
  id             String       @id @default(uuid())
  joinCode       String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  scenarioId     String
  scenario       Scenario     @relation(fields: [scenarioId], references: [id])
  status         String       @default("draft") // draft, active, closed
  createdAt      DateTime     @default(now())
  
  currentRound   Int          @default(1)
  isRoundActive  Boolean      @default(false)
  globalState    String       @default("{}") // JSON string for dynamic pricing modifiers, events, etc.
  
  participants    SessionParticipant[]
  rounds          Round[]
  interactions    Interaction[]
  surveyResponses SurveyResponse[]
  teams           Team[]
  tradeRequests   TradeRequest[]
  bankInventories BankInventory[]
}

model BankInventory {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  productKey   String   // e.g., 'wheat', 'wine'
  quantity     Int      @default(0) // Tracks how many the bank has bought from players
  
  @@unique([sessionId, productKey])
}

model SessionParticipant {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  
  // Dynamic Game State per Participant
  capital        Float    @default(0)
  rawMaterial    Int      @default(0)
  techLevel      Int      @default(1)
  productionEff  Float    @default(1.0) // 1.0 = normal
  inventory      String   @default("{}") // JSON string mapped to objects
  
  joinedAt  DateTime @default(now())
  
  @@unique([sessionId, userId])
}

model Round {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  number    Int
  state     String   @default("open") // open, closed
  
  interactions Interaction[]
}

model Interaction {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  roundId      String
  round        Round    @relation(fields: [roundId], references: [id])
  
  fromUserId   String
  fromUser     User     @relation("SentInteractions", fields: [fromUserId], references: [id])
  toUserId     String?
  toUser       User?    @relation("ReceivedInteractions", fields: [toUserId], references: [id])
  toTeam       String?  // nullable if target is a specific user instead of a team
  
  type         String   // e.g., trade, info-share
  resourceType String?
  quantity     Int?
  timestamp    DateTime @default(now())
}

model SurveyResponse {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  
  userId       String
  user         User     @relation("SurveyResponder", fields: [userId], references: [id])
  
  questionId   String
  
  targetUserId String?
  targetUser   User?    @relation("SurveyTarget", fields: [targetUserId], references: [id])
  
  answer       Int      // e.g., Likert scale value
}

// --- GLOBAL EXCHANGE SPECIFIC MODELS ---

model Team {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id])
  
  name           String   // e.g., "Team Alpha"
  teamType       String   // e.g., "Alpha", "Beta", "Gamma"
  
  participants   SessionParticipant[]
}

model TradeRequest {
  id                 String   @id @default(uuid())
  sessionId          String
  session            Session  @relation(fields: [sessionId], references: [id])
  
  fromUserId         String
  fromUser           User     @relation("SentTrades", fields: [fromUserId], references: [id])
  toUserId           String
  toUser             User     @relation("ReceivedTrades", fields: [toUserId], references: [id])
  
  // JSON strings: { capital: 0, rawMaterial: 0, wheat: 0, ... }
  offeredResources   String   @default("{}")
  requestedResources String   @default("{}")
  
  message            String?  // Optional note from the sender
  status             String   @default("pending") // pending, accepted, rejected, cancelled
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
