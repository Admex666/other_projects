generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String    @id @default(uuid())
  name         String
  industry     String?
  orgStructure Json?
  
  users        User[]
  sessions     Session[]
}

model User {
  id             String       @id @default(uuid())
  name           String
  role           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  teamMembership String? // Deprecated, use SessionParticipant.teamId instead
  
  sessions             SessionParticipant[]
  sentInteractions     Interaction[]        @relation("SentInteractions")
  receivedInteractions Interaction[]        @relation("ReceivedInteractions")
  surveyResponses      SurveyResponse[]     @relation("SurveyResponder")
  surveyTargets        SurveyResponse[]     @relation("SurveyTarget")
}

model Scenario {
  id              String    @id @default(uuid())
  name            String
  behavioralFocus String?
  config          Json
  version         String
  
  sessions        Session[]
}

model Session {
  id             String       @id @default(uuid())
  joinCode       String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  scenarioId     String
  scenario       Scenario     @relation(fields: [scenarioId], references: [id])
  status         String       @default("draft") // draft, active, closed
  createdAt      DateTime     @default(now())
  
  participants    SessionParticipant[]
  rounds          Round[]
  interactions    Interaction[]
  surveyResponses SurveyResponse[]
  teams           Team[]
  contracts       Contract[]
  alliances       Alliance[]
}

model SessionParticipant {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  
  joinedAt  DateTime @default(now())
  
  @@unique([sessionId, userId])
}

model Round {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  number    Int
  state     String   @default("open") // open, closed
  
  interactions Interaction[]
}

model Interaction {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  roundId      String
  round        Round    @relation(fields: [roundId], references: [id])
  
  fromUserId   String
  fromUser     User     @relation("SentInteractions", fields: [fromUserId], references: [id])
  toUserId     String?
  toUser       User?    @relation("ReceivedInteractions", fields: [toUserId], references: [id])
  toTeam       String?  // nullable if target is a specific user instead of a team
  
  type         String   // e.g., trade, info-share
  resourceType String?
  quantity     Int?
  timestamp    DateTime @default(now())
}

model SurveyResponse {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  
  userId       String
  user         User     @relation("SurveyResponder", fields: [userId], references: [id])
  
  questionId   String
  
  targetUserId String?
  targetUser   User?    @relation("SurveyTarget", fields: [targetUserId], references: [id])
  
  answer       Int      // e.g., Likert scale value
}

// --- GLOBAL EXCHANGE SPECIFIC MODELS ---

model Team {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id])
  
  name           String   // e.g., "Team Alpha"
  teamType       String   // e.g., "Alpha", "Beta", "Gamma"
  
  // Dynamic Game State
  capital        Float    @default(0)
  rawMaterial    Int      @default(0)
  techLevel      Int      @default(1)
  productionEff  Float    @default(1.0) // 1.0 = normal, 1.4 = +40%
  
  participants   SessionParticipant[]
  
  // Relations for contracts/alliances
  contractsAsProvider Contract[] @relation("ProviderTeam")
  contractsAsReceiver Contract[] @relation("ReceiverTeam")
  
  allianceId     String?
  alliance       Alliance? @relation(fields: [allianceId], references: [id])
}

model Contract {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id])
  
  providerTeamId String
  providerTeam   Team     @relation("ProviderTeam", fields: [providerTeamId], references: [id])
  receiverTeamId String
  receiverTeam   Team     @relation("ReceiverTeam", fields: [receiverTeamId], references: [id])
  
  type           String   // e.g., "TechLease", "RevenueShare", "Protection"
  status         String   @default("active") // active, expired, broken
  
  // Terms
  techLevelGiven Int?
  revenuePercent Float?   // e.g., 0.40 for 40%
  durationMintues Int?
  
  createdAt      DateTime @default(now())
  expiresAt      DateTime?
}

model Alliance {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id])
  
  name           String
  createdAt      DateTime @default(now())
  
  teams          Team[]
}
