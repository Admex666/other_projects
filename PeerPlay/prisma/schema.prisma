generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String    @id @default(uuid())
  name         String
  industry     String?
  orgStructure Json?
  
  users        User[]
  sessions     Session[]
}

model User {
  id             String       @id @default(uuid())
  name           String
  role           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  teamMembership String? // Deprecated, use SessionParticipant.teamId instead
  
  sessions             SessionParticipant[]
  sentInteractions     Interaction[]        @relation("SentInteractions")
  receivedInteractions Interaction[]        @relation("ReceivedInteractions")
  surveyResponses      SurveyResponse[]     @relation("SurveyResponder")
  surveyTargets        SurveyResponse[]     @relation("SurveyTarget")
}

model Scenario {
  id              String    @id @default(uuid())
  name            String
  behavioralFocus String?
  config          Json
  version         String
  
  sessions        Session[]
}

model Session {
  id             String       @id @default(uuid())
  joinCode       String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  scenarioId     String
  scenario       Scenario     @relation(fields: [scenarioId], references: [id])
  status         String       @default("draft") // draft, active, closed
  createdAt      DateTime     @default(now())
  
  participants    SessionParticipant[]
  rounds          Round[]
  interactions    Interaction[]
  surveyResponses SurveyResponse[]
  teams           Team[]
  tradeRequests   TradeRequest[]
}

model SessionParticipant {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  
  // Individual Resources
  capital        Float    @default(0)
  rawMaterial    Int      @default(0)
  techLevel      Int      @default(1)
  productionEff  Float    @default(1.0)
  
  // Individual Shape Inventory
  circleCount    Int      @default(0)
  triangleCount  Int      @default(0)
  squareCount    Int      @default(0)
  hexagonCount   Int      @default(0)
  
  joinedAt  DateTime @default(now())
  
  // Relations for individual trades
  sentTradeRequests   TradeRequest[] @relation("SentTradeRequests")
  receivedTradeRequests TradeRequest[] @relation("ReceivedTradeRequests")
  
  @@unique([sessionId, userId])
}

model Round {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  number    Int
  state     String   @default("open") // open, closed
  
  interactions Interaction[]
}

model Interaction {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  roundId      String
  round        Round    @relation(fields: [roundId], references: [id])
  
  fromUserId   String
  fromUser     User     @relation("SentInteractions", fields: [fromUserId], references: [id])
  toUserId     String?
  toUser       User?    @relation("ReceivedInteractions", fields: [toUserId], references: [id])
  toTeam       String?  // nullable if target is a specific user instead of a team
  
  type         String   // e.g., trade, info-share
  resourceType String?
  quantity     Int?
  timestamp    DateTime @default(now())
}

model SurveyResponse {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  
  userId       String
  user         User     @relation("SurveyResponder", fields: [userId], references: [id])
  
  questionId   String
  
  targetUserId String?
  targetUser   User?    @relation("SurveyTarget", fields: [targetUserId], references: [id])
  
  answer       Int      // e.g., Likert scale value
}

// --- GLOBAL EXCHANGE SPECIFIC MODELS ---

model Team {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id])
  
  name           String   // e.g., "Team Alpha"
  teamType       String   // e.g., "Alpha", "Beta", "Gamma"
  
  participants   SessionParticipant[]
}

// Bipolar Trade Request
model TradeRequest {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id])
  
  // The person offering the trade
  senderId       String
  sender         SessionParticipant @relation("SentTradeRequests", fields: [senderId], references: [id])
  
  // The person receiving the request
  receiverId     String
  receiver       SessionParticipant @relation("ReceivedTradeRequests", fields: [receiverId], references: [id])
  
  status         String   @default("pending") // pending, accepted, rejected, cancelled
  
  // What the sender is OFFERING
  offerType      String   // 'capital', 'rawMaterial', 'techLevel', 'circle', 'triangle', 'square', 'hexagon'
  offerQuantity  Int      @default(1)
  
  // What the sender is REQUESTING IN RETURN
  requestType    String   // 'capital', 'rawMaterial', 'techLevel', 'circle', 'triangle', 'square', 'hexagon'
  requestQuantity Int     @default(1)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
